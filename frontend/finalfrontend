    ========================= */

    function toggleMenu() {

        const nav = document.getElementById("navLinks");

        nav.classList.toggle("show");

    }


    /* =========================
       SMOOTH SCROLL
    ========================= */

    function scrollToSection(id) {

        const element = document.getElementById(id);

        if (element) {

            element.scrollIntoView({
                behavior: "smooth"
            });

        }

    }


    /* =========================
       SEARCH
    ========================= */

    function searchWebsite() {

        const input =
            document.getElementById("searchInput");

        const message =
            document.getElementById("searchMessage");

        const query =
            input.value.trim();


        if (query === "") {

            message.innerHTML =
                "⚠️ Please enter something to search.";

            message.classList.add("show");

            return;
        }


        message.innerHTML =
            `🔎 Showing results for "<strong>${query}</strong>". More opportunities will appear here in the full version.`;

        message.classList.add("show");

    }


    /* Search with Enter key */

    document
        .getElementById("searchInput")
        .addEventListener("keydown", function(event) {

            if (event.key === "Enter") {

                searchWebsite();

            }

        });



    /* =========================
       LOGIN MODAL
    ========================= */

    function openLogin() {

        document
            .getElementById("loginModal")
            .classList.add("show");

    }


    function closeLogin() {

        document
            .getElementById("loginModal")
            .classList.remove("show");

    }


    function loginUser() {

        alert(
            "Demo Login Successful! In the real project, this will connect to your backend."
        );

        closeLogin();

    }


    /* Close modal when clicking outside */

    window.addEventListener("click", function(event) {

        const modal =
            document.getElementById("loginModal");

        if (event.target === modal) {

            closeLogin();

        }

    });



    /* =========================
       SCHEME DETAILS
    ========================= */

    function showDetails(schemeName) {

        alert(
            schemeName +
            "\n\nEligibility, benefits, documents and application details will be displayed here."
        );

    }



    /* =========================
       NAVBAR ACTIVE LINK
    ========================= */

    const sections =
        document.querySelectorAll("section[id]");

    const navItems =
        document.querySelectorAll(".nav-links a");


    window.addEventListener("scroll", function() {

        let current = "";


        sections.forEach(section => {

            const sectionTop =
                section.offsetTop - 120;

            if (window.scrollY >= sectionTop) {

                current =
                    section.getAttribute("id");

            }

        });


        navItems.forEach(link => {

            link.classList.remove("active");

            if (
                link.getAttribute("href") ===
                "#" + current
            ) {

                link.classList.add("active");

            }

        });

    });



    /* =========================
       CLOSE MOBILE MENU
    ========================= */

    document.querySelectorAll(".nav-links a")
        .forEach(link => {

            link.addEventListener("click", function() {

                document
                    .getElementById("navLinks")
                    .classList.remove("show");

            });

        });


</script>

</body>
</html>